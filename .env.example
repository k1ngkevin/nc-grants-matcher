# Copy to .env (or set in Azure Container Apps) — everything is optional.

# Public URL used in email links
PUBLIC_BASE_URL=http://localhost:8000

# --- Email (without SMTP_HOST, emails are written to server/data/outbox/) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=NC Federal Funds Matchmaker <grants-alerts@example.nc.gov>
# Only let these domains subscribe (comma-separated). Empty = any.
ALLOWED_EMAIL_DOMAINS=nc.gov,unc.edu,nccommunitycolleges.edu
REQUIRE_EMAIL_CONFIRMATION=true

# --- Azure OpenAI (without these: local TF-IDF matching + rule-based explanations) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_EMBEDDING_DEPLOYMENT=
AZURE_CHAT_DEPLOYMENT=

# --- SAM.gov Assistance Listings enrichment (free key at sam.gov) ---
SAM_API_KEY=

# --- Ops ---
FINANCIAL_FLOOR=50000
DAILY_INGEST_HOUR=6
SCHEDULED_INGEST=live          # live | off
SEED_SAMPLE_IF_EMPTY=true      # load the SAMPLE dataset when the database is empty
ADMIN_TOKEN=                   # enables POST /api/admin/ingest with header X-Admin-Token

# Copy to .env in this folder; the server reads it on startup (real environment variables
# take priority). In Azure Container Apps, set these as environment variables instead.
# Local defaults work without credentials. Production authentication is required.
#
# Docker's --env-file reads each line literally: keep comments on their own lines and
# don't put quotes around values, or they become part of the value.

# Public address of the site. Links in emails use it, so once real email is on it must be
# an address the people getting the emails can open (not localhost).
PUBLIC_BASE_URL=http://localhost:8000

# --- Authentication ---
# Local only. In Azure set APP_ENV=production, AUTH_MODE=entra,
# ENTRA_TENANT_ID to the approved tenant UUID, and PUBLIC_BASE_URL to HTTPS.
# Enable Container Apps Easy Auth BEFORE exposing the app. See docs/access-control.md.
# Do not set AUTH_MODE=development on a production deployment.
APP_ENV=development
AUTH_MODE=development
ENTRA_TENANT_ID=

# --- Email (without ACS_CONNECTION_STRING or SMTP_HOST, emails are written to server/data/outbox/) ---
# Check your settings with:  cd server && python -m app.emailer you@agency.nc.gov
# SMTP_FROM is the sender either way, and must be an address your mail service lets you send from.
#
# Option 1, Azure Communication Services (no SMTP login needed): paste the connection string from
# your Communication Services resource > Settings > Keys, and set SMTP_FROM to your email domain's
# MailFrom address (e.g. DoNotReply@xxxx.azurecomm.net). Microsoft is retiring ACS Email on
# September 30, 2028, so treat it as a short-term option.
ACS_CONNECTION_STRING=
#
# Option 2, any SMTP server. Port 587 uses STARTTLS; port 465 uses SSL.
#   SendGrid:  SMTP_HOST=smtp.sendgrid.net  SMTP_USER=apikey  SMTP_PASSWORD=<your API key>
#   ACS over SMTP:  SMTP_HOST=smtp.azurecomm.net  (login comes from an Entra app; see the ACS SMTP docs)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=NC Federal Funds Matchmaker <grants-alerts@example.nc.gov>
# Only let these domains subscribe (comma-separated). edu,gov permits any
# .edu or .gov recipient. This does not verify the sender or grant app access.
# Empty = any recipient (local development only).
ALLOWED_EMAIL_DOMAINS=edu,gov
REQUIRE_EMAIL_CONFIRMATION=true

# --- Azure OpenAI (without these: local TF-IDF matching + rule-based explanations) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_EMBEDDING_DEPLOYMENT=
AZURE_CHAT_DEPLOYMENT=

# --- SAM.gov Assistance Listings enrichment (free key at sam.gov) ---
SAM_API_KEY=

# --- Ops ---
FINANCIAL_FLOOR=50000
DAILY_INGEST_HOUR=6
# Daily live ingest: live | off
SCHEDULED_INGEST=live
# Load the SAMPLE dataset when the database is empty
SEED_SAMPLE_IF_EMPTY=true
# Local development only: enables POST /api/admin/ingest with X-Admin-Token.
# Production uses the Matchmaker.Admin Entra role instead.
ADMIN_TOKEN=
